        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{app=\"tokenservice-api\"} | json | filetype = \"walletController\" | line_format \"{{ date \\\"02.01.2006 15:04:05\\\" __timestamp__ }} {{.message}}\"",
